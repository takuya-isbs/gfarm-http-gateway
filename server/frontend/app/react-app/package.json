{
  "name": "gfarm-http-gateway-webui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "bootstrap": "^5.3.8",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.3",
    "virtua": "^0.54.2"
  },
  "scripts": {
    "start": "vite --mode development --no-open",
    "build": "vite build --mode production",
    "lint": "eslint ./src tests playwright*.config.js --ext .js,.jsx && prettier --check \"tests/**/*.js\" playwright*.config.js",
    "lint:fix": "eslint ./src --ext .js,.jsx --fix",
    "test:unit-webui:all": "playwright test",
    "test:unit-webui:chromium": "playwright test --project=chromium",
    "test:unit-webui:firefox": "playwright test --project=firefox",
    "test:unit-webui:webkit": "playwright test --project=webkit",
    "test:unit-webui:chromium:ui": "playwright test --project=chromium --ui",
    "test:unit-webui:firefox:ui": "playwright test --project=firefox --ui",
    "test:unit-webui:webkit:ui": "playwright test --project=webkit --ui",
    "test:unit-webui:chromium:headed": "playwright test --project=chromium --headed"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.2",
    "@vitejs/plugin-react": "^6.2.1",
    "adm-zip": "^0.5.16",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "vite": "^8.3.5",
    "vite-jsconfig-paths": "^2.0.1",
    "web-vitals": "^6.2.3"
  }
}
